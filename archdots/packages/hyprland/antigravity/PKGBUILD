description='googles ai powered ide'
url='https://antigravity.google'
depends=(
  'custom:pup'
  'apt:jq'
  'apt:curl'
)
source=(
  'https://aur.archlinux.org/cgit/aur.git/plain/antigravity.desktop?h=antigravity'
  'https://aur.archlinux.org/cgit/aur.git/plain/antigravity.png?h=antigravity'
)
# source_on_check=false
# asks user for elevated privileges
elevated=true
# make this package platform specific. Examples: linux, windows, archlinux, ubuntu
platform='ubuntu'

# All items of source will be downloaded and extracted (when necessary)
# all downloaded (or extracted folders) are stored inside ${sourced[@]}
# This script runs inside a folder over ~/.cache/archdots/pkgname, where all sources are downloaded
#
# $PKGPATH has the path to folder containing this file

# You can add the suffix "_powershell" to the functions in order to run them using powershell

# This function is used to install the package on the system
install() {
  download_link="$(curl -s https://aur.archlinux.org/packages/antigravity | pup '#pkgsrcslist li json{}' | jq -r '.[]|.children[]|select(.text|endswith("x86_64.tar.gz"))|.href')"
  wget "$download_link"
  tar -xvf "Antigravity.tar.gz"

  pkgname="antigravity"
  desktop_file="${sourced[1]}"
  png_file="${sourced[2]}"

  if [ -d /opt/Antigravity ]; then
    rm -r /opt/Antigravity
  fi

  install -d "/opt"
  cp -a Antigravity-*/ "/opt/Antigravity"

  cd "${sourced[0]}"

  if [ -f "/usr/bin/$pkgname" ]; then
    rm "/usr/bin/$pkgname"
  fi

  install -d "/usr/bin"
  ln -s /opt/Antigravity/antigravity "/usr/bin/$pkgname"

  install -d "/usr/share/licenses/$pkgname"
  ln -s /opt/Antigravity/LICENSE.electron.txt -t "/usr/share/licenses/$pkgname"
  ln -s /opt/Antigravity/LICENSES.chromium.html -t "/usr/share/licenses/$pkgname"

  install -Dm644 "$desktop_file" -t "/usr/share/applications/antigravity.desktop"
  install -Dm644 "$png_file" -t "/usr/share/pixmaps/antigravity.png"

  chown root:root /opt/Antigravity/chrome-sandbox
  chmod 4755 /opt/Antigravity/chrome-sandbox
}

# This function is used to uninstall the package from the system
uninstall() {
  pkgname="antigravity"

  rm -r "/opt/Antigravity"

  rm "/usr/bin/$pkgname"

  rm -r "/usr/share/licenses/$pkgname"

  rm "/usr/share/applications/$pkgname.desktop"
  rm "/usr/share/pixmaps/$pkgname.png"
}

# This function should end with exit code 0 when the package is installed on system
# and end with exit code 1 when it is uninstalled
check() {
  which antigravity
}
