description='logins to ghcr.io with personal token'
url=''
depends=('custom:bws' 'apt:jq')
source=()
# source_on_check=false
# asks user for elevated privileges
# elevated=false
# make this health script platform specific. Examples: linux, windows, archlinux, ubuntu
platform='linux'

# All items of source will be downloaded and extracted (when necessary)
# all downloaded (or extracted folders) are stored inside ${sourced[@]}
# This script runs inside a folder over ~/.cache/archdots/pkgname, where all sources are downloaded
#
# $PKGPATH has the path to folder containing this file

# You can add the suffix "_powershell" to the functions in order to run them using powershell

# This function is used to configure the health script
install() {
  if ! [ -v GITHUB_PACKAGES_PAT ]; then
    echo "GITHUB_PACKAGES_PAT variable does not exist. Make sure ~/.secrets.sh is configured"
    exit 1
  fi

  echo $GITHUB_PACKAGES_PAT | docker login ghcr.io -u AlanJs26 --password-stdin
}

# This function is used to unconfigure the health script
uninstall() {
  jq 'del(.auths."ghcr.io")' ~/.docker/config.json >~/.docker/config.json
}

# This function should end with exit code 0 when the health script is configured
# and end with exit code 1 when it is unconfigured
check() {
  grep "ghcr.io" ~/.docker/config.json
}
